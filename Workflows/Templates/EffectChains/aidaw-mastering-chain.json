{
  "schema_version": 1,
  "id": "aidaw-mastering-chain",
  "name": "AIDAW Mastering Chain",
  "version": "0.0.1",
  "description": "GoldenTips-inspired tonal balance with wider stereo. Analyze input gain, mud and loudness per source; optional reverb and mono bass remain off.",
  "stages": [
    {
      "id": "gain",
      "enabled": true,
      "purpose": "Input trim before EQ",
      "plugin": {
        "name": "AIDAW Gain",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Gain dB",
          "value": 0.75
        }
      ]
    },
    {
      "id": "eq",
      "enabled": true,
      "purpose": "Correct tonal balance",
      "plugin": {
        "name": "AIDAW EQ",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": []
    },
    {
      "id": "enhancer",
      "enabled": true,
      "purpose": "Gentle shelves and parallel high-band saturation",
      "plugin": {
        "name": "AIDAW Enhancer",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Low contour",
          "value": 0.11
        },
        {
          "name": "Process",
          "value": 0.2
        },
        {
          "name": "Output dB",
          "value": 0.6111111111111112
        }
      ]
    },
    {
      "id": "reverb",
      "enabled": false,
      "purpose": "Optional space",
      "plugin": {
        "name": "AIDAW Reverb",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Wet",
          "value": 0.03
        },
        {
          "name": "Room size",
          "value": 0.3
        },
        {
          "name": "Damping",
          "value": 0.6
        }
      ]
    },
    {
      "id": "imager",
      "enabled": true,
      "purpose": "Stereo width",
      "plugin": {
        "name": "AIDAW Imager",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Width",
          "value": 0.7
        },
        {
          "name": "Bass width",
          "value": 1
        },
        {
          "name": "Bass Hz",
          "value": 0.2222222222222222
        },
        {
          "name": "Full band",
          "value": 1
        },
        {
          "name": "Mid dB",
          "value": 0.5416666666666666
        },
        {
          "name": "Side dB",
          "value": 0.5
        }
      ]
    },
    {
      "id": "bassmono",
      "enabled": false,
      "purpose": "Constrain low-frequency side after spatial processing",
      "plugin": {
        "name": "AIDAW BassMono",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Mono cutoff Hz",
          "value": 0.20833333333333334
        },
        {
          "name": "Mono amount",
          "value": 1
        }
      ]
    },
    {
      "id": "limiter",
      "enabled": true,
      "purpose": "Final output ceiling",
      "plugin": {
        "name": "AIDAW Limiter",
        "vendor": "AIDAW",
        "format": "VST3",
        "version": "0.0.1"
      },
      "parameters": [
        {
          "name": "Drive dB",
          "value": 0
        },
        {
          "name": "Ceiling dBFS",
          "value": 0.9166666666666666
        },
        {
          "name": "Release ms",
          "value": 0.09090909090909091
        }
      ]
    }
  ]
}
